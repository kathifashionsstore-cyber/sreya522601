    "firebase": "^12.6.0",
    "firebase-admin": "^14.1.0",
    "formidable": "^3.5.4",
    "framer-motion": "^12.23.25",
    "gsap": "^3.13.0",
    "locomotive-scroll": "^5.0.0-beta.21",
